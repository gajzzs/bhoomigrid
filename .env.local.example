# Copy this file to .env.local and fill in real values before enabling
# the external GIS overlays in src/lib/gis-providers.ts

# ISRO Bhuvan (NRSC) WMS gateway. Free registration at https://bhuvan.nrsc.gov.in
# The default public endpoint works for some layers without a key; higher-resolution
# / restricted layers require a token appended per Bhuvan's API docs.
NEXT_PUBLIC_BHUVAN_WMS_URL=https://bhuvan-vec1.nrsc.gov.in/bhuvan/wms

# Your own QGIS Server or GeoServer instance, publishing state cadastral /
# DILRMP layers prepared in QGIS Desktop as WMS.
NEXT_PUBLIC_QGIS_SERVER_WMS_URL=http://localhost:8080/qgisserver/cadastral
NEXT_PUBLIC_QGIS_SERVER_LAYER=cadastral_parcels

# Existing production database connection (already used by pg-client.ts)
DATABASE_URL=postgresql://user:password@localhost:5432/nlams
